 # ==============================================================================
# FraudShield AI — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, PRODUCTION-GRADE SECRETS
# ==============================================================================

# Core Application Settings
PROJECT_NAME="FraudShield AI"
VERSION="1.0.0"
ENVIRONMENT="production"

# Cryptographic Authentication Secret (Minimum 32 bytes of secure random entropy)
# Generate with: openssl rand -hex 32
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"

# Database Configuration (PostgreSQL in production, SQLite in development)
POSTGRES_USER="fraudshield_user"
POSTGRES_PASSWORD="REPLACE_WITH_SECURE_DATABASE_PASSWORD"
POSTGRES_DB="fraudshield_db"
DATABASE_URL="postgresql://fraudshield_user:REPLACE_WITH_SECURE_DATABASE_PASSWORD@localhost:5432/fraudshield_db"

# Allowed Cross-Origin Resource Sharing Origins (comma-separated, NO wildcards)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# External Threat Intelligence APIs (Optional - Graceful fallback if omitted)
VIRUSTOTAL_API_KEY=""
URLHAUS_API_KEY=""
GOOGLE_WEBRISK_API_KEY=""

# Multi-Device Campaign Correlation Thresholds
CAMPAIGN_MIN_DETECTIONS=3
CAMPAIGN_MIN_DEVICES=2
CAMPAIGN_WINDOW_HOURS=24
CAMPAIGN_WINDOW_SECONDS=3600

# File Forensics Upload Security Limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR="./uploads"

# Network & Proxy Security
TRUST_PROXY_HEADERS=False
