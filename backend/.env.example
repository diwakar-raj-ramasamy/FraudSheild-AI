# FraudShield AI Backend Configuration
PROJECT_NAME="FraudShield AI"
VERSION="1.0.0"
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
DATABASE_URL="sqlite:///./fraudshield.db"
# Or for PostgreSQL in Docker/Production:
# DATABASE_URL="postgresql://fraudshield_user:REPLACE_WITH_SECURE_DATABASE_PASSWORD@localhost:5432/fraudshield_db"

# Optional External Threat Intelligence Keys (Graceful fallback if blank)
VIRUSTOTAL_API_KEY=""
URLHAUS_API_KEY=""
GOOGLE_WEBRISK_API_KEY=""

# Multi-Device Campaign Thresholds
CAMPAIGN_MIN_DETECTIONS=3
CAMPAIGN_MIN_DEVICES=2
CAMPAIGN_WINDOW_HOURS=24

# File Analysis Limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR="./uploads"

# Security Settings
TRUST_PROXY_HEADERS=False
